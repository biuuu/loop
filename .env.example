HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/loop.sqlite
# Optional server-only word list (default: data/sensitive-words.txt).
LOOP_SENSITIVE_WORDS_FILE=
# Optional site-wide Netease cookie. Never expose this to the browser.
NETEASE_COOKIE=
# Optional mainland China public IP for legacy Netease API header compatibility.
NETEASE_MUSIC_API_REALIP=
# Admin-only QR login page at /admin/netease. Generate: openssl rand -hex 32
LOOP_ADMIN_KEY=
# Optional destination for the scanned server-side cookie (default: data/netease-cookie).
NETEASE_COOKIE_FILE=
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
# Enable only when cloudflared forwards to LOOP on the same machine.
# Requires HOST=127.0.0.1 or HOST=::1.
TRUST_CLOUDFLARE_TUNNEL=false
# Successful new nickname-based accounts per client IP in a rolling hour.
SIGNUP_MAX_PER_HOUR=5
# Configure all three to enable Turnstile for account creation.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
# Email-code login. Leave SMTP unset to keep only temporary-user entry enabled.
# Generate AUTH_SECRET locally (for example: openssl rand -hex 32); keep it private.
AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
