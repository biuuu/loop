{
  "name": "loop-cat-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env src/server/index.ts --development\" \"vite --host 0.0.0.0\"",
    "check": "vue-tsc --noEmit",
    "format": "prettier --write src test scripts *.json *.ts *.html *.md docs/*.md",
    "test": "node scripts/test.mjs",
    "scan:text": "node --env-file-if-exists=.env --import tsx scripts/scan-text.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^10.1.10",
    "@lucide/vue": "^1.72.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "nodemailer": "^10.5.0",
    "pinia": "^3.0.0",
    "pixi.js": "^8.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "undici": "^7.30.2",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
